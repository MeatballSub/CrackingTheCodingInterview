#!/usr/bin/env sh
#
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
script="$here/bench_all.py"

if [ ! -f "$script" ]; then
    echo "bench_all: cannot find $script" >&2
    exit 1
fi

for candidate in python python3 py; do
    command -v "$candidate" >/dev/null 2>&1 || continue
    if "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 7) else 1)' \
        >/dev/null 2>&1; then
        exec "$candidate" "$script" "$@"
    fi
done

echo "bench_all: no working Python 3.7+ found (tried python, python3, py)" >&2
exit 1
