            },
            {
                "Len": {
                    "expected": 1
                }
            },
            {
                "Pop": {
                    "expected": 42
                }
            },
            {
                "IsEmpty": {
                    "expected": true
                }
            },
            {
                "Len": {
                    "expected": 0
                }
            },
            {
                "Pop": {
                    "expected": null
                }
            }
        ]
    },
