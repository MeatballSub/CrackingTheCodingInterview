[
    {
        "description": "empty stack: peek, pop, and sort all leave it empty",
        "operations": [
            {
                "IsEmpty": {
                    "expected": true
                }
            },
            {
                "Len": {
                    "expected": 0
                }
            },
            {
                "Peek": {
                    "expected": null
                }
            },
            {
                "Pop": {
                    "expected": null
                }
            },
            "Sort",
            {
                "IsEmpty": {
                    "expected": true
                }
            },
            {
                "Len": {
                    "expected": 0
                }
            },
            {
                "Peek": {
                    "expected": null
                }
            },
            {
                "Pop": {
                    "expected": null
                }
            }
        ]
    },
    {
        "description": "a single element survives a sort",
